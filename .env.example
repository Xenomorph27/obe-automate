# .env.example — copy this to .env and fill in your values
# NEVER commit .env to git

# ── LLM Keys (at least one required) ───────────────────────────────────
GEMINI_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...        # Optional — last resort fallback

# ── Database ─────────────────────────────────────────────────────────────
# Local dev (SQLite — default, no setup needed):
DATABASE_URL=sqlite:///./obe_automate.db

# Production (Railway PostgreSQL — Railway sets this automatically):
# DATABASE_URL=postgresql://user:password@host:5432/railway

# ── App ──────────────────────────────────────────────────────────────────
DEBUG=false
